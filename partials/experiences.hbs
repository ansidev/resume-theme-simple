{{#if resume.work}}
<section class="section mb-3">
  <h4 class="section-title mb-3">
    {{bootstrapIcon 'briefcase-fill'}}Employment History
  </h4>

  <div class="section-content">
    {{#resume.work}}
    <div class="d-flex flex-column">
      <div class="d-flex justify-content-between">
        <h5 class="company">{{#if url}}<a href="{{url}}" target="_blank">{{/if}}{{companyName}}{{#if location}},
            {{location}}{{/if}}{{#if url}}</a>{{/if}}</h5>
        <div class="time fst-italic">{{year startDate}} - {{year endDate}}</div>
      </div>
      <h6 class="job-title">{{position}}</h6>
      <div class="details">
        {{#markdown}}{{summary}}{{/markdown}}

        {{#if highlights}}
        <ul>
          {{#each highlights}}
          <li class="highlight">{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
    </div>
    {{/resume.work}}
  </div>
</section>
{{/if}}
