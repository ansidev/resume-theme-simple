{{#if resume.languages}}
<div class="widget">
  <h6 class="widget-title mb-2">Languages</h6>
  <div class="widget-content">
    <ul class="list-unstyled">
      {{#resume.languages}}
      <li class="language">{{language}} <span class="lang-desc">({{fluency}})</span></li>
      {{/resume.languages}}
    </ul>
  </div>
</div>
{{/if}}
