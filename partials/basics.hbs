{{#resume.basics}}
<div class="widget">
  <h6 class="widget-title mb-2">Details</h6>
  <div class="widget-content">
    <ul class="list-unstyled">
      {{#if location}}<li class="location">{{bootstrapIcon 'geo-alt-fill'}}{{location.city}}, {{location.countryCode}}</li>{{/if}}
      {{#if email}}<li class="email">{{bootstrapIcon 'envelope-fill'}}<a href="mailto:{{email}}">{{email}}</a></li>{{/if}}
      {{#if phone}}<li class="phone">{{bootstrapIcon 'telephone-fill'}}</i><a href="tel:{{phone}}">{{phone}}</a></li>{{/if}}
    </ul>
  </div>
</div>
{{/resume.basics}}
