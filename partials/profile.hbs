{{#resume.basics}}
<div class="profile-container col d-flex pb-3">
  {{#if image}}
  <div class="flex-shrink-0">
    <img class="profile" src="{{image}}" alt="" />
  </div>
  {{/if}}
  <div class="flex-grow-1 ms-3">
    <h3 class="name">{{name}}</h3>
    <p class="tagline">{{label}}</p>
  </div>
</div>
<!--//profile-container-->
{{/resume.basics}}
